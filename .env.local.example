# Supabase environment variables (new API keys)
# Copy this file to .env.local and fill in your own values. Never commit real keys.
# Get them from: Supabase dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Publishable key (starts with sb_publishable_), safe for the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Secret key (starts with sb_secret_), server only, never expose to the browser
SUPABASE_SECRET_KEY=your-secret-key-here
